# ── Required — app will not start without these ───────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monadmate
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Monad Mate Trust API"
DEBUG=false
ENVIRONMENT=development

# ── Monad ─────────────────────────────────────────────────────────────────────
# Wallet auth works without these. Needed for on-chain stake/escrow.
# Deploy contracts: cd contracts && bash scripts/deploy_testnet.sh
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_NETWORK=testnet
MONAD_CHAIN_ID=10143
MONAD_ESCROW_ADDRESS=
MONAD_EVENT_LOG_ADDRESS=
# Backend authority key — only this key can refund/slash. Keep it out of git.
MONAD_PRIVATE_KEY=
MONAD_KEYSTORE_PATH=~/.monad/backend.key

# ── Hedera HCS ────────────────────────────────────────────────────────────────
# Sign up (free testnet): https://portal.hedera.com
# Without this: attestations/safety actions are not anchored to HCS.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=
HEDERA_NETWORK=testnet

# ── ZeroDB (vector memory for AI matching) ───────────────────────────────────
# Get a free key: https://ainative.studio
# Without this: AI matching still works using built-in Postgres embeddings.
ZERODB_API_KEY=
ZERODB_PROJECT_ID=
ZERODB_API_URL=https://api.ainative.studio

# ── OpenAI (optional — enhances intro generation) ────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Stake thresholds (MON) ───────────────────────────────────────────────────
MIN_STAKE_DM_MON=0.5
MIN_STAKE_MEETUP_MON=2.0
MIN_STAKE_ROOM_MON=1.0
SLASH_AMOUNT_NO_SHOW=5.0

# ── Celery / Redis (background workers) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
